{
  "name": "linkedin-scraper-mcp",
  "version": "1.0.0",
  "description": "LinkedIn job scraper MCP tool for Claude Code — scrapes job postings, detects language, and exports to CSV or Excel",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "linkedin-scraper-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:ui": "node dist/server.js",
    "dev": "tsx src/index.ts",
    "dev:ui": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "franc": "^6.2.0",
    "linkedin-jobs-scraper": "^18.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
